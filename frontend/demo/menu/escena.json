{
  "circulo ƒ": "(color, tamaño, x, y, z) => { /* renderiza un circulo */ }",
  "esparcir circulos ƒ": "(cantidad, xC, yC, radio, color, tamaño, z) => { const dibujar = diarsaba.get('circulo ƒ'); for(let i=0; i<cantidad; i++){ dibujar(color, tamaño, xC+(Math.random()*radio*2-radio), yC+(Math.random()*radio*2-radio), z); } }",
  "trazo ƒ": "(color, grosor, z, puntos) => { /* renderiza una linea continua uniendo los puntos */ }",

  "1 sol !": ["circulo ƒ", "amarillo", "10px", 10, 10, 0],
  "2 luna !": ["circulo ƒ", "blanco", "8px", 90, 15, 0],
  
  "3 follaje !": ["esparcir circulos ƒ", 20, 50, 25, 15, "verde", "10px", 1],
  "4 manzanas !": ["esparcir circulos ƒ", 5, 50, 25, 12, "rojo", "2px", 2],
  
  "5 tronco base !": ["trazo ƒ", "marron", "15px", 0, [[45, 70], [44, 55], [45, 45]]],
